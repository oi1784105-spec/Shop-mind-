# Copy the following values into vendor/ragflow/docker/.env as appropriate.
# Do not commit real credentials or API keys.

SHOPMIND_ADMIN_USERNAME=admin
SHOPMIND_ADMIN_PASSWORD=replace-with-a-strong-password
RAGFLOW_API_KEY=ragflow-your-api-key
# Keep this value aligned with the REDIS_PASSWORD used by RAGFlow's .env.
# ShopMind uses Redis database 2; RAGFlow keeps its own database separate.
REDIS_PASSWORD=replace-with-a-redis-password
RAGFLOW_SHOPMIND_TENANT_ID=replace-with-your-ragflow-tenant-id
# Disable the RAGFlow operations login form for the localhost-only 8081 entry.
# Set to false if the operations UI must require its normal admin login.
RAGFLOW_ADMIN_NO_LOGIN=true

# Optional: leave blank to use the tenant defaults configured in RAGFlow.
RAGFLOW_DEFAULT_LLM_ID=
RAGFLOW_DEFAULT_EMBEDDING_MODEL=
RAGFLOW_REQUEST_TIMEOUT_SECONDS=180
SHOPMIND_COOKIE_SECURE=false

# Product ports. RAGFlow operations stays localhost-only on 8081.
SHOPMIND_WEB_PORT=8080
SHOPMIND_API_PORT=8000
RAGFLOW_OPS_HTTP_PORT=8081
